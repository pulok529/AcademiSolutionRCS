# =============================================================================
# AcademiSolutionRCS — Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file → rename to .env
#   2. Fill in all values for your environment
#   3. NEVER commit .env to Git — it is in .gitignore
#   4. This .env.example file IS committed — keep values empty/placeholder only
# =============================================================================

# ─── MSSQL Server ─────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=
MSSQL_HOST=academi-mssql
MSSQL_PORT=1433

# ─── Per-Service Database Connection Strings ──────────────────────────────────
ACADEMIC_DB_CONNECTION=
ACCOUNTS_DB_CONNECTION=
HRM_DB_CONNECTION=
NOTIFICATION_DB_CONNECTION=
KEYCLOAK_DB_CONNECTION=

# ─── Keycloak (Identity / Auth) ───────────────────────────────────────────────
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=http://academi-keycloak:8080

# ─── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_HOST=academi-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECTION=

# ─── RabbitMQ Message Bus ─────────────────────────────────────────────────────
RABBITMQ_HOST=academi-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ─── YARP API Gateway ─────────────────────────────────────────────────────────
GATEWAY_PORT=5000
GATEWAY_JWT_AUTHORITY=
GATEWAY_JWT_AUDIENCE=

# ─── Academic Service ─────────────────────────────────────────────────────────
ACADEMIC_SERVICE_PORT=5001
ACADEMIC_SERVICE_URL=http://academi-academic:5001

# ─── Accounts Service ─────────────────────────────────────────────────────────
ACCOUNTS_SERVICE_PORT=5002
ACCOUNTS_SERVICE_URL=http://academi-accounts:5002

# ─── HRM Service ──────────────────────────────────────────────────────────────
HRM_SERVICE_PORT=5003
HRM_SERVICE_URL=http://academi-hrm:5003

# ─── Notification Service ─────────────────────────────────────────────────────
NOTIFICATION_SERVICE_PORT=5004
NOTIFICATION_SERVICE_URL=http://academi-notification:5004

# ─── Report Service ───────────────────────────────────────────────────────────
REPORT_SERVICE_PORT=5005
REPORT_SERVICE_URL=http://academi-report:5005

# ─── Email (MailKit / SMTP) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Academi School System
SMTP_USE_SSL=true

# ─── Seq (Log Aggregation) ────────────────────────────────────────────────────
SEQ_URL=http://academi-seq:5341
SEQ_API_KEY=

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ─── Nginx ────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENVIRONMENT=Development
APP_VERSION=1.0.0
